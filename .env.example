# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key both work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by scripts/seed-dev.ts and the DB integration tests, never by the app.
SUPABASE_SECRET_KEY=

# Optional: voice audio. From LiveKit Cloud → Settings → Keys. Leave empty for presence-only voice.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
